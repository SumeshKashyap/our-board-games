{
  "version": "2.0.0",
  "options": {
    "env": {
      "ANDROID_HOME": "${env:HOME}/Android/Sdk",
      "PATH": "${env:HOME}/Android/Sdk/platform-tools:${env:PATH}"
    }
  },
  "tasks": [
    {
      "label": "Build debug APK",
      "type": "shell",
      "command": "./gradlew assembleDebug",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run on device",
      "type": "shell",
      "command": "./gradlew installDebug && adb shell am start -n com.sumesh.ourchess/.MainActivity",
      "problemMatcher": []
    },
    {
      "label": "Unit tests",
      "type": "shell",
      "command": "./gradlew testDebugUnitTest",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Screenshots (phone + tablet)",
      "type": "shell",
      "command": "./gradlew recordRoborazziDebug && echo 'Saved to app/build/outputs/roborazzi/'",
      "problemMatcher": []
    },
    {
      "label": "Logcat (app only)",
      "type": "shell",
      "command": "adb logcat --pid=$(adb shell pidof -s com.sumesh.ourchess)",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "List connected devices",
      "type": "shell",
      "command": "adb devices -l",
      "problemMatcher": []
    },
    {
      "label": "Build release APK (family, with photos)",
      "type": "shell",
      "command": "./gradlew assembleRelease -PappVersion=${input:version} && cp app/build/outputs/apk/release/app-release.apk OurBoardGames-v${input:version}-family.apk && echo 'Saved OurBoardGames-v${input:version}-family.apk'",
      "problemMatcher": []
    },
    {
      "label": "Install release APK on device",
      "type": "shell",
      "command": "./gradlew installRelease",
      "problemMatcher": []
    },
    {
      "label": "Publish release (push version tag)",
      "type": "shell",
      "command": "git tag -a v${input:version} -m 'Our Board Games v${input:version}' && git push origin v${input:version} && echo 'GitHub is now building the release: https://github.com/'$(gh repo view --json nameWithOwner -q .nameWithOwner)'/actions'",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "version",
      "type": "promptString",
      "description": "Version number, e.g. 1.2.0 (no 'v')",
      "default": "1.0.0"
    }
  ]
}